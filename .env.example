###############
# Application #
###############

APP_HOST=127.0.0.1
APP_PORT=8000

INGESTION_TIMEOUT=120s
STATE_READ_TIMEOUT=10s

#################
# API container #
#################

API_IMAGE=xkcd-api:local
API_BIND_ADDRESS=127.0.0.1

GO_IMAGE=golang:1.26-alpine

################
# Dapr sidecar #
################

DAPR_CONTAINER_IMG=1.18.7

DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# Allow the SDK time to connect while the sidecar starts.
DAPR_CLIENT_TIMEOUT_SECONDS=60

####################################
# Dapr HTTP binding: metadata only #
####################################

XKCD_BASE_URL=https://xkcd.com
XKCD_MAX_RESPONSE_BODY_SIZE=1Mi

##########################################
# Shared metadata/image request behavior #
##########################################

XKCD_USER_AGENT=xkcd-archive-demo/0.1
XKCD_REQUEST_GAP=30s
XKCD_RATE_LIMIT_COOLDOWN=15m
XKCD_MAX_IMAGE_BYTES=20971520

######################
# Dapr cron bindings #
######################

LATEST_SCHEDULE="@every 1h"
BACKFILL_SCHEDULE="@every 1m"

########################
# PostgreSQL container #
########################

## Default: 17-alpine
POSTGRES_CONTAINER_IMG=
## Default: 127.0.0.1
POSTGRES_BIND_ADDRESS=
## Default: 5432
POSTGRES_PORT=
## Default: postgres-data
POSTGRES_DATA_DIR=

#################################################
# PostgreSQL: host-based development connection #
#################################################

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=xkcd
POSTGRES_USER=xkcd

# Keep your existing value here.
POSTGRES_PASSWORD=daprxkcd

POSTGRES_SSLMODE=disable

#########
# Caddy #
#########

## Default: 127.0.0.1:80
CADDY_HTTP_PORT=
